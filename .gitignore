# Local scratch
/temp/
/tmp/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment and secrets
.env
.env.*
!.env.example
!.env.*.example

# OS and editor noise
.DS_Store
Thumbs.db
Desktop.ini
.idea/

# Node dependencies and package-manager caches
node_modules/
.pnpm-store/

# Next.js / frontend build output
.next/
out/
dist/
build/
.turbo/
.vercel/
.netlify/
.swc/
coverage/

# Generated frontend files
next-env.d.ts
tsconfig.tsbuildinfo
*.tsbuildinfo

# Client app: keep source files, ignore generated/runtime output
/client/node_modules/
/client/.pnpm-store/
/client/.next/
/client/out/
/client/dist/
/client/build/
/client/.turbo/
/client/.vercel/
/client/.netlify/
/client/.swc/
/client/coverage/

# Generated from root /assets by client/scripts/sync-public-assets.mjs.
# Required at runtime, but reproducible via pnpm dev/build/sync:assets.
/client/public/assets/
/client/next-env.d.ts
/client/tsconfig.tsbuildinfo
/client/*.tsbuildinfo
