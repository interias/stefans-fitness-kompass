# Absolute Base-URL der veröffentlichten Seite (ohne abschließenden Slash).
# Einzige Stelle, die bei einem Domainwechsel angepasst werden muss – sie steuert
# Canonical-URLs, hreflang-Alternates, Open Graph, sitemap.xml und robots.txt.
#
# Beim Build setzen (z. B. in CI / Cloudflare) und Inhalte neu erzeugen.
# Fällt ohne Wert auf die workers.dev-Adresse zurück (siehe client/lib/site.ts).
NEXT_PUBLIC_SITE_URL=https://stefans-fitness-kompass.stefanboerzel.workers.dev
